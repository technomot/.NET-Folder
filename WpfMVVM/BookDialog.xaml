<Window x:Class="WpfMVVM.BookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Book" Height="440" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Title" FontSize="12" Margin="0 0 0 4"/>
            <TextBox x:Name="TxtTitle" FontSize="13" Padding="6 4" Margin="0 0 0 12" Height="32"/>
            <TextBlock Text="Author" FontSize="12" Margin="0 0 0 4"/>
            <TextBox x:Name="TxtAuthor" FontSize="13" Padding="6 4" Margin="0 0 0 12" Height="32"/>
            <Grid Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Pages" FontSize="12" Margin="0 0 0 4"/>
                    <TextBox x:Name="TxtPages" FontSize="13" Padding="6 4" Height="32"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Price" FontSize="12" Margin="0 0 0 4"/>
                    <TextBox x:Name="TxtPrice" FontSize="13" Padding="6 4" Height="32"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Published date" FontSize="12" Margin="0 0 0 4"/>
            <DatePicker x:Name="DtpPublished" FontSize="13" Height="32" Margin="0 0 0 16"/>
            <CheckBox x:Name="ChkAvailable" Content="Available" FontSize="13"
                      IsChecked="True" Margin="0 0 0 0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Save" Width="90" Height="32" Margin="0 0 10 0"
                    Background="#007ACC" Foreground="White" BorderThickness="0"
                    Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="90" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>