<Window x:Class="WpfMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfMVVM.ViewModels"
        Title="Library MVVM" Height="520" Width="860"
        MinHeight="400" MinWidth="600">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16 6"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2D2D30">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0">
                <TextBlock Text="📚 Library MVVM" Foreground="White" FontSize="14"
                           VerticalAlignment="Center" Margin="0 0 24 0"/>
                <Button Content="Add Book" Style="{StaticResource ToolbarButton}"
                        Background="#007ACC" Command="{Binding AddCommand}"/>
                <Button Content="Delete" Style="{StaticResource ToolbarButton}"
                        Background="#CC4444" Command="{Binding DeleteCommand}"/>
                <Button Content="Save JSON" Style="{StaticResource ToolbarButton}"
                        Background="#5A7A9A" Command="{Binding SaveCommand}"/>
                <Button Content="Load JSON" Style="{StaticResource ToolbarButton}"
                        Background="#5A7A9A" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5"
                BorderBrush="#DDDDDD" BorderThickness="0 0 1 0">
            <StackPanel Margin="12">
                <TextBlock Text="Filter" FontSize="13" FontWeight="SemiBold" Margin="0 8 0 8"/>
                <TextBlock Text="Search by title:" FontSize="12" Margin="0 0 0 4"/>
                <TextBox FontSize="12" Padding="6 4" Margin="0 0 0 12"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Show only:" FontSize="12" Margin="0 0 0 4"/>
                <RadioButton Content="All books" FontSize="12" Margin="0 0 0 4"
                             IsChecked="{Binding ShowAll}"/>
                <RadioButton Content="Available only" FontSize="12"
                             IsChecked="{Binding ShowAvailable}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="Gray" Margin="0 16 0 0"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  FontSize="13"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title"     Binding="{Binding Title}"   Width="*"/>
                <DataGridTextColumn Header="Author"    Binding="{Binding Author}"  Width="*"/>
                <DataGridTextColumn Header="Pages"     Binding="{Binding Pages}"   Width="60"/>
                <DataGridTextColumn Header="Price"     Binding="{Binding Price, StringFormat={}{0:F2}}" Width="80"/>
                <DataGridTextColumn Header="Published" Binding="{Binding PublishedDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#007ACC">
            <TextBlock Text="{Binding StatusText}" Foreground="White"
                       FontSize="12" VerticalAlignment="Center" Margin="12 0"/>
        </Border>
    </Grid>
</Window>