<Window x:Class="WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management System"
        Height="520" Width="860"
        MinHeight="400" MinWidth="600">

    <Window.Resources>
        
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16 6"/>
            <Setter Property="Margin" Value="0 0 8 0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#2D2D30">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12 0">
                <TextBlock Text="📚 Library Management System"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0 0 24 0"/>
                <Button Content="Add Book"
                        Style="{StaticResource ToolbarButton}"
                        Background="#007ACC"
                        Click="BtnAdd_Click"/>
                <Button Content="Edit"
                        Style="{StaticResource ToolbarButton}"
                        Background="#5A8A5A"
                        Click="BtnEdit_Click"/>
                <Button Content="Delete"
                        Style="{StaticResource ToolbarButton}"
                        Background="#CC4444"
                        Click="BtnDelete_Click"/>
                <Button Content="Save JSON"
                        Style="{StaticResource ToolbarButton}"
                        Background="#5A7A9A"
                        Click="BtnSave_Click"/>
                <Button Content="Load JSON"
                        Style="{StaticResource ToolbarButton}"
                        Background="#5A7A9A"
                        Click="BtnLoad_Click"/>
            </StackPanel>
        </Border>

        
        <Border Grid.Row="1" Grid.Column="0"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="0 0 1 0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top"
                           Text="Filter"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0 8 0 8"/>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Search by title:" FontSize="12" Margin="0 0 0 4"/>
                    <TextBox x:Name="TxtSearch"
                             FontSize="12"
                             Padding="6 4"
                             Margin="0 0 0 12"
                             TextChanged="TxtSearch_TextChanged"/>

                    <TextBlock Text="Show only:" FontSize="12" Margin="0 0 0 4"/>
                    <RadioButton x:Name="RbAll"
                                 Content="All books"
                                 IsChecked="True"
                                 FontSize="12"
                                 Margin="0 0 0 4"
                                 Checked="Filter_Changed"/>
                    <RadioButton x:Name="RbAvailable"
                                 Content="Available only"
                                 FontSize="12"
                                 Margin="0 0 0 4"
                                 Checked="Filter_Changed"/>
                    <RadioButton x:Name="RbUnavailable"
                                 Content="Unavailable only"
                                 FontSize="12"
                                 Checked="Filter_Changed"/>

                    <TextBlock x:Name="TxtCount"
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0 16 0 0"/>
                </StackPanel>
                <StackPanel/>
            </DockPanel>
        </Border>

        
        <DataGrid x:Name="BooksGrid"
                  Grid.Row="1" Grid.Column="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  FontSize="13"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Title"
                                    Binding="{Binding Title}"
                                    Width="*"/>
                <DataGridTextColumn Header="Author"
                                    Binding="{Binding Author}"
                                    Width="*"/>
                <DataGridTextColumn Header="Pages"
                                    Binding="{Binding Pages}"
                                    Width="60"/>
                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price, StringFormat={}{0:F2}}"
                                    Width="80"/>
                <DataGridTextColumn Header="Published"
                                    Binding="{Binding PublishedDate, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="100"/>
                <DataGridCheckBoxColumn Header="Available"
                                        Binding="{Binding IsAvailable}"
                                        Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>